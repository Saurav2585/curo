# Curo — environment variables (copy to .env.local and fill in)

# --- Supabase (existing) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (NEW) ---
# Server-only. Used by payment verification + webhook to call the
# security-definer payment functions. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (NEW) ---
# Server-only secrets:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public key id used by Razorpay Checkout in the browser (same value as RAZORPAY_KEY_ID):
NEXT_PUBLIC_RAZORPAY_KEY_ID=
